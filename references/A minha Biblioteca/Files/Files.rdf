                <rdf:value>https://ieeexplore.ieee.org/abstract/document/9837035</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-01-05 22:02:10</dcterms:dateSubmitted>
        <bib:pages>86904-86919</bib:pages>
    </bib:Article>
