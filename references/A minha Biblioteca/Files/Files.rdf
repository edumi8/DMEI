        <link:link rdf:resource="#item_59"/>
        <dc:subject>
            <z:AutomaticTag>
                <rdf:value>Computers / Distributed Systems / Client-Server Computing</rdf:value>
            </z:AutomaticTag>
        </dc:subject>
        <dc:subject>
            <z:AutomaticTag>
