    <bib:Thesis rdf:about="https://hammer.purdue.edu/articles/thesis/IMPROVING_MICROSERVICES_OBSERVABILITY_IN_CLOUD-NATIVE_INFRASTRUCTURE_USING_EBPF/22682623/1">
        <z:itemType>thesis</z:itemType>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Purdue University Graduate School</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
